@incollection{crovellaSimulationsHeavyTailedWorkloads2000,
  title = {Simulations with {{Heavy-Tailed Workloads}}},
  booktitle = {Self-{{Similar Network Traffic}} and {{Performance Evaluation}}},
  author = {Crovella, Mark E. and Lipsky, Lester},
  date = {2000},
  pages = {89--100},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/047120644X.ch3},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/047120644X.ch3},
  urldate = {2025-03-10},
  abstract = {Network traffic self-similarity is a phenomenon of increasing interest in the networking community. The fact that network traffic often shows self-similarity means that it shows noticeable bursts at a wide range of time scales—typically at least four or five orders of nagnitude. A related observation is that file sizes in some systems have been shown to be well described using distributions that are heavy-tailed, i.e., file sizes also span many orders of magnitude. Designers of computing and telecommunication systems are increasingly interested in employing heavy-tailed distributions to generate workloads for use in simulation. This chapter discusses characteristics of simulations with heavy-tailed inputs. In particular, these simulations are less stable and may exhibit two features: first, they will be very slow to converge to steady state; and second, they will show highly variable performance at steady state. In general, many of the problems associated with simulations using heavy-tailed workloads seem quite difficult to solve. This chapter does not primarily suggest solutions but rather draws attention to these problems, both to yield insight for researchers using simulation and to suggest areas in which more research is needed.},
  isbn = {978-0-471-20644-6},
  langid = {english},
  keywords = {heavy-tailed distributions,heavy-tailed workloads,infinite variance,instability,notion,simulation},
  file = {/home/rodff/Zotero/storage/489IQ2N4/Crovella und Lipsky - 2000 - Simulations with Heavy-Tailed Workloads.pdf;/home/rodff/Zotero/storage/H4UKTPAT/047120644X.html}
}

