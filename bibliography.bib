  urldate = {2025-02-28},
  abstract = {Zipf's law (; German pronunciation: [tsɪpf]) is an empirical law stating that when a list of measured values is sorted in decreasing order, the value of the n-th entry is often approximately inversely proportional to n. The best known instance of Zipf's law applies to the frequency table of words in a text or corpus of natural language:                                                          w             o             r             d                           f             r             e             q             u             e             n             c             y                                       ∝                                           1                                                                                w                   o                   r                   d                                       r                   a                   n                   k                                                                                                    .                 \{\textbackslash displaystyle \textbackslash{} \{\textbackslash mathsf \{word\textbackslash{} frequency\}\}\textbackslash{} \textbackslash propto \textbackslash{} \{\textbackslash frac \{1\}\{\textbackslash{} \{\textbackslash mathsf \{word\textbackslash{} rank\}\}\textbackslash{} \}\}\textasciitilde.\}    It is usually found that the most common word occurs approximately twice as often as the next common one, three times as often as the third most common, and so on.  For example, in the Brown Corpus of American English text, the word "the" is the most frequently occurring word, and by itself accounts for nearly 7\% of all word occurrences (69,971 out of slightly over 1 million). True to Zipf's law, the second-place word "of" accounts for slightly over 3.5\% of words (36,411 occurrences), followed by "and" (28,852). It is often used in the following form, called Zipf-Mandelbrot law:                                                          f             r             e             q             u             e             n             c             y                                       ∝                                           1                                                                                (                                                                                                              r                         a                         n                         k                                                                 +                     b                                                            )                                                     a                                                                                                            \{\textbackslash displaystyle \textbackslash{} \{\textbackslash mathsf \{frequency\}\}\textbackslash{} \textbackslash propto \textbackslash{} \{\textbackslash frac \{1\}\{\textbackslash{} \textbackslash left(\textbackslash{} \{\textbackslash mathsf \{rank\}\}+b\textbackslash{} \textbackslash right)\textasciicircum\{a\}\textbackslash{} \}\}\textbackslash{} \}     where                                   a                           \{\textbackslash displaystyle \textbackslash{} a\textbackslash{} \}     and                                   b                           \{\textbackslash displaystyle \textbackslash{} b\textbackslash{} \}     are fitted parameters, with                                   a         ≈         1                 \{\textbackslash displaystyle \textbackslash{} a\textbackslash approx 1\}    , and                                   b         ≈         2.7                           \{\textbackslash displaystyle \textbackslash{} b\textbackslash approx 2.7\textasciitilde\}    . This law is named after the American linguist George Kingsley Zipf, and is still an important concept in quantitative linguistics. It has been found to apply to many other types of data studied in the physical and social sciences. In mathematical statistics, the concept has been formalized as the Zipfian distribution: A family of related discrete probability distributions whose rank-frequency distribution is an inverse power law relation. They are related to Benford's law and the Pareto distribution. Some sets of time-dependent empirical data deviate somewhat from Zipf's law. Such empirical distributions are said to be quasi-Zipfian.},
  langid = {english},
  keywords = {notion},
  annotation = {Page Version ID: 1275263209},
  file = {/home/rodff/Zotero/storage/R2VXLFA5/Zipf's_law.html}
}

